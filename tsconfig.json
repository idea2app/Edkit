{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "declaration": true,
        "rootDir": "source/",
        "outDir": "dist/"
    },
    "include": ["source/**/*"],
    "typedocOptions": {
        "name": "Edkit",
        "includeVersion": true,
        "excludeExternals": true,
        "excludePrivate": true,
        "readme": "ReadMe.md",
        "plugin": ["typedoc-plugin-mdn-links"],
        "navigationLinks": {
            "GitHub": "https://github.com/idea2app/Edkit"
        }
    }
}
