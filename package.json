{
    "name": "edkit",
    "version": "1.3.2",
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "contributors": [
        "1101077695@qq.com"
    ],
    "description": "Lightweight Rich Text Editor toolkit based on TypeScript",
    "keywords": [
        "rich-text",
        "html",
        "editor",
        "typescript"
    ],
    "homepage": "https://idea2app.github.io/Edkit/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/idea2app/Edkit.git"
    },
    "bugs": {
        "url": "https://github.com/idea2app/Edkit/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
    },
    "workspaces": [
        "React",
        "WebCell",
        "React/test",
        "WebCell/test"
    ],
    "dependencies": {
        "@swc/helpers": "^0.5.23",
        "@types/turndown": "^5.0.6",
        "browser-fs-access": "^0.38.0",
        "regenerator-runtime": "^0.14.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "web-utility": "^4.8.1"
    },
    "peerDependencies": {
        "marked": ">=4.0.10"
    },
    "devDependencies": {
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.21",
        "@types/node": "^26.6.6",
        "bootstrap": "^6.0.0-alpha.1",
        "bootstrap-icons": "^1.13.2",
        "husky": "^9.1.7",
        "koapache": "^3.0.0",
        "lint-staged": "^17.6.0",
        "marked": "^18.1.2",
        "open-cli": "^9.0.0",
        "parcel": "~2.16.4",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "start-server-and-test": "^3.0.13",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{html,md,less,json,yml,js,ts,tsx}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        }
    },
    "scripts": {
        "prepare": "husky",
        "install": "playwright install --with-deps chromium firefox webkit",
        "test-pack-WebCell": "cd WebCell/test  &&  parcel build index.html --dist-dir ../../test/dist/webcell --public-url . --no-cache --no-optimize --no-scope-hoist",
        "test-pack-React": "cd React/test  &&  parcel build index.html --dist-dir ../../test/dist/react --public-url . --no-cache --no-optimize --no-scope-hoist",
        "test-pack": "npm run test-pack-WebCell  &&  npm run test-pack-React",
        "test-serve": "web-server test/dist --port 8080",
        "test-run": "cd test  &&  node --enable-source-maps --import @swc-node/register/esm-register --test --test-concurrency=1 *.test.ts",
        "test-browser": "start-server-and-test test-serve \"http://127.0.0.1:8080/webcell/index.html|http://127.0.0.1:8080/react/index.html\" test-run",
        "lint": "lint-staged  &&  tsc --noEmit -p test/tsconfig.json",
        "test": "npm run lint  &&  npm run test-pack  &&  npm run test-browser",
        "pack-dist": "rm -rf dist/  &&  parcel build --no-cache",
        "pack-docs": "rm -rf docs/  &&  typedoc source/",
        "build": "npm run pack-dist  &&  npm run pack-docs",
        "start": "npm run pack-docs  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    }
}
