{
    "name": "react-bootstrap-editor",
    "version": "3.0.0-rc.0",
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "contributors": [
        "1101077695@qq.com"
    ],
    "description": "Lightweight Rich Text Editor based on TypeScript, React & Bootstrap",
    "keywords": [
        "rich-text",
        "html",
        "editor",
        "typescript",
        "react",
        "bootstrap"
    ],
    "homepage": "https://github.com/idea2app/Edkit/tree/master/React/",
    "bugs": {
        "url": "https://github.com/idea2app/Edkit/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
    },
    "dependencies": {
        "@swc/helpers": "^0.5.23",
        "edkit": "workspace:^",
        "mobx-react-helper": "^0.5.4",
        "web-utility": "^4.8.1"
    },
    "peerDependencies": {
        "mobx": ">=6.11",
        "mobx-react": ">=9",
        "react": ">=16",
        "react-dom": ">=16.4.2"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "mobx": "^7.1.4",
        "mobx-react": "^10.0.3",
        "parcel": "~2.16.4",
        "process": "^0.11.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "~6.0.3"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        }
    },
    "scripts": {
        "clean": "rm -rf .parcel-cache/ dist/",
        "start": "npm run clean  &&  cd test/  &&  parcel index.html --open",
        "pack-demo": "cd test/  &&  parcel build index.html --dist-dir ../../docs/React --public-url . --no-cache",
        "build": "npm run clean  &&  parcel build --no-cache",
        "prepublishOnly": "npm run build  &&  npm run pack-demo"
    }
}
